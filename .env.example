# ============================================================
# AI stock — 환경변수 예시 파일
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요.
# .env 파일은 절대 Git에 커밋하지 마세요.
# ============================================================

# 한국투자증권 Open API 인증정보
# KIS Developers(https://apiportal.koreainvestment.com)에서 앱 등록 후 발급
KIS_APP_KEY=your_real_or_mock_app_key_here
KIS_APP_SECRET=your_real_or_mock_app_secret_here

# 실전투자 계좌 (KIS_USE_MOCK=false 시 사용)
KIS_ACCOUNT_NO=your_real_account_number_here
KIS_ACCOUNT_PRODUCT_CODE=01

# 모의투자 계좌 (KIS_USE_MOCK=true 시 사용)
KIS_MOCK_ACCOUNT_NO=your_mock_account_number_here
KIS_MOCK_ACCOUNT_PRODUCT_CODE=01

# 실행 모드 (기본값: true = 모의투자)
# 반드시 충분한 검증 후에만 false로 변경
KIS_USE_MOCK=true

# 실전투자 활성화 (기본값: false, 절대 임의로 true로 바꾸지 마세요)
# live_trade: true, kis.use_mock: false, safety.confirm_live_trade: true
# 세 조건 모두 충족 시에만 실전 주문 가능
LIVE_TRADE=false
